  "source_model_records": {
    "operando_xrd": {
      "metadata_sha256": "08b4f84f03ec0c6a0520e3383bf8968f52445b1dde57c042d69f9a79a355c39e",
      "scientific_basis": {
        "schema_version": 1,
        "model_class": "analytic_model",
        "data_origin": "original_synthetic",
        "parameter_origin": "independently chosen teaching inputs, no fitted material or copied paper values",
        "equations": [
          "Q(t)=I*t/3600; x(t)=Q(t)/Qhost; I=180 mA/g, Qhost=180 mAh/g, 0<=t<=3600 s",
          "a(x)=4.16*(1-0.012*x) Å; d_hkl=a/sqrt(h²+k²+l²); hkl=(111),(200)",
          "2theta=2*asin(lambda/(2d)); lambda=1.5406 Å",
          "I(2theta,t)=background+sum A_hkl*exp[-0.5*((2theta-two_theta_hkl(t))/sigma_hkl)²]",
          "V(t)=3.20+0.83*x(t)+0.18*x(t)^7 (declared phenomenological voltage, not derived from crystal energy)"
        ],
        "parameters": {
          "wavelength_A": 1.5406,
          "lattice_a0_A": 4.16,
          "fractional_lattice_change_at_x1": -0.012,
          "hkl": [
            [
              1,
              1,
              1
            ],
            [
              2,
              0,
              0
            ]
          ],
          "sigma_deg": [
            0.13,
            0.15
          ],
          "amplitudes_au": [
            0.9,
            0.77
          ],
          "background_au": 0.045,
          "current_mA_g": 180,
          "host_capacity_mAh_g": 180,
          "duration_s": 3600
        },
        "assumptions": [
          "One fictitious cubic host, shared lattice at each timestamp; no independent peak motion.",
          "The legacy soc_fraction field stores assumed site progress derived from the declared current ledger; no measured SOC.",
          "Time, occupation, peak positions and voltage use the same recorded timestamps.",
          "Gaussian line profiles and assumed voltage are teaching specializations; no instrument or chemical fit."
        ],
        "references": [
          {
            "url": "https://www.nature.com/articles/s41467-022-33931-4",
            "title": "On the nanoscale structural evolution of solid discharge products in lithium-sulfur batteries using operando scattering",
            "supports": "Figure 2e–g and Methods support pairing scattering/time with electrochemical records and separately inspecting peak width/strain. No Li-S phase, measured point or material parameter is transferred.",
            "scope": "model_definition_only",
            "checked_date": "2026-10-01"
          },
          {
            "url": "https://iupac.org/wp-content/uploads/2019/05/IUPAC-GB3-2012-2ndPrinting-PDFsearchable.pdf",
            "title": "IUPAC Green Book, third edition",
            "supports": "Section 2.8 defines reciprocal crystal geometry; cubic d_hkl and first-order Bragg specialization are independently calculated.",
            "scope": "model_definition_only",
            "checked_date": "2026-10-01"
          }
        ],
        "limitations": [
          "No phase identification, lattice refinement, measured SOC, operando acquisition or experimental voltage fit.",
          "Peak intensity is arbitrary signal; its amplitude is not a phase fraction or concentration."
        ],
        "validation_scope": "Common-lattice Bragg identities, finite nonnegative signals and exact time/charge/voltage indexing; no material validation."
      }
    },
    "raman_series": {
      "metadata_sha256": "9e6a0dbe1fc0a9030a0515aa94aecacbc868bf80143db96029da71ca425b66e7",
      "scientific_basis": {
        "schema_version": 1,
        "model_class": "phenomenological_model",
        "data_origin": "original_synthetic",
        "equations": [
          "I_A-D(x)=45+0.14*(x-680)+(330-45*index)*G(x;730,4.5)+(100+55*index)*G(x;745+0.6*index,5.2)+55*G(x;783,6)",
          "Display-only offset = 340 counts per series; raw intensities are unchanged"
        ],
        "parameters": {
          "wavenumber_cm_1_range": [
            680,
            810
          ],
          "samples": [
            "A",
            "B",
            "C",
            "D"
          ],
          "offset_counts": 340
        },
        "assumptions": [
          "Generic nonnegative band shapes and background; common acquisition scale is assumed."
        ],
        "references": [
          {
            "url": "https://www.itl.nist.gov/div898/handbook/eda/section3/eda3661.htm",
            "title": "NIST e-Handbook: normal distribution",
            "supports": "The Gaussian mathematical line shape only; no material peak assignment or numeric data.",
            "scope": "model_definition_only"
          }
        ],
        "limitations": [
          "No molecule, solvation state, concentration, measured shift or peak-area calibration is assigned."
        ],
        "validation_scope": "Declared teaching model and internal relationships only; no experimental or material certification."
      }
    },
    "xps_components": {
      "metadata_sha256": "c9c49a4ce7d26c3d53b063771eeace0741a5c3a8fe23fb01aec1e8a23595c3ff",
      "scientific_basis": {
        "schema_version": 1,
        "model_class": "phenomenological_model",
        "data_origin": "original_synthetic",
        "equations": [
          "G(e)=exp(-0.5*((e-mu)/sigma)^2); L(e)=1/(1+((e-mu)/sigma)^2)",
          "component=height*(0.7*G+0.3*L); expected_counts=110+3*(e-280)+sum(components)",
          "observed_counts ~ Poisson(expected_counts); residual=observed-background-sum(known_components)"
        ],
        "parameters": {
          "peak_centers_eV": [
            284.7,
            286.4,
            289.0
          ],
          "shape_width_eV": [
            0.5,
            0.64,
            0.71
          ],
          "peak_heights_counts": [
            1000,
            460,
            270
          ],
          "lorentzian_fraction": 0.3,
          "random_seed": 20260927
        },
        "assumptions": [
          "Nonnegative independent counting statistics on known generic components and a linear background.",
          "The mixture width is a shape parameter; it is not claimed as a common Gaussian/Lorentzian FWHM."
        ],
        "references": [
          {
            "url": "https://www.itl.nist.gov/div898/handbook/eda/section3/eda3661.htm",
            "title": "NIST e-Handbook: normal distribution",
            "supports": "The Gaussian mathematical line shape only; no material peak assignment or numeric data.",
            "scope": "model_definition_only"
          },
          {
            "url": "https://goldbook.iupac.org/terms/view/L03628",
            "title": "IUPAC: Lorentzian band shape",
            "supports": "Lorentzian mathematical shape only; original energies and intensities.",
            "scope": "model_definition_only"
          }
        ],
        "limitations": [
          "No optimizer, fitted composition, charge calibration, Shirley/Tougaard background or chemical assignment.",
          "Components are known inputs; residuals are not evidence of a successful experimental fit."
        ],
        "validation_scope": "Declared teaching model and internal relationships only; no experimental or material certification."
      }
    }
